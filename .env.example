# Directory containing raw/ and analyses/. Keep large media outside Git.
VOLLEYCUT_DATA_ROOT=/path/to/volleycut-data

# Optional labeling workspace containing tasks, proxies, Sol prelabels, completed
# labels, manifests, and model artifacts. The local workstation default is used
# when this is omitted.
# VOLLEYCUT_LABELING_WORKSPACE=/path/to/volleycut-data/labeling-v1

# Optional supplemental challenge/intake workspace. Its tasks and analyses are
# shown in the UIs but remain isolated from training manifests and labels.
# VOLLEYCUT_INTAKE_WORKSPACE=/path/to/volleycut-data/intake-workspace

# Optional beach-exclusion comparison artifacts. Defaults point at the local
# retraining workspace used by the research report.
# VOLLEYCUT_NO_BEACH_ANALYSES_ROOT=/path/to/no-beach-workspace/analyses
# VOLLEYCUT_NO_BEACH_LABELING_WORKSPACE=/path/to/no-beach-workspace
# VOLLEYCUT_NO_BEACH_V0_WORKSPACE=/path/to/no-beach-v0-workspace

# Optional Linux/Intel acceleration. Requires Docker, the pinned Jellyfin image,
# and /dev/dri/renderD128. Omit for the portable FFmpeg/libx264 path.
# VOLLEYCUT_PROXY_BACKEND=jellyfin-vaapi
# VOLLEYCUT_VAAPI_IMAGE=jellyfin/jellyfin@sha256:17285f9cce63b3519ccad82b84497fc22482c20f8b8bbe0580d51fec5deaa6fd

# Optional comma-separated hostnames for LAN development through a custom DNS
# name or reverse proxy. Active non-loopback IPv4 interfaces are allowed
# automatically. Do not include schemes or ports.
# VOLLEYCUT_DEV_ORIGINS=volleycut.local
