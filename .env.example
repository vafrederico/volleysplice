# Directory containing raw/ and analyses/. Keep large media outside Git.
VOLLEYCUT_DATA_ROOT=/path/to/volleycut-data

# Optional durable store for imported production/Android model-feedback JSON.
# Server-visible source links can be attached but are not required. Defaults to
# $VOLLEYCUT_DATA_ROOT/model-feedback.
# VOLLEYCUT_MODEL_FEEDBACK_ROOT=/path/to/model-feedback

# Optional labeling workspace containing tasks, proxies, Sol prelabels, completed
# labels, manifests, and model artifacts. The local workstation default is used
# when this is omitted.
# VOLLEYCUT_LABELING_WORKSPACE=/path/to/volleycut-data/labeling-v1

# Optional supplemental challenge/intake workspace. Its tasks and analyses are
# shown in the UIs but remain isolated from training manifests and labels.
# VOLLEYCUT_INTAKE_WORKSPACE=/path/to/volleycut-data/intake-workspace
# Optional path-delimited list when several isolated intake workspaces should
# appear together in the labeling UI (":" on Linux/macOS, ";" on Windows).
# VOLLEYCUT_INTAKE_WORKSPACES=/path/to/intake-a:/path/to/intake-b

# Optional beach-exclusion comparison artifacts. Defaults point at the local
# retraining workspace used by the research report.
# VOLLEYCUT_NO_BEACH_ANALYSES_ROOT=/path/to/no-beach-workspace/analyses
# VOLLEYCUT_NO_BEACH_LABELING_WORKSPACE=/path/to/no-beach-workspace
# VOLLEYCUT_NO_BEACH_V0_WORKSPACE=/path/to/no-beach-v0-workspace

# Optional side-switch review inputs. The default workstation paths point to
# the full-NAS appearance report/decision map plus the frozen V5, V5 production-
# state, and V6 artifacts. Override each artifact set together for another corpus.
# VOLLEYCUT_SIDE_SWITCH_REPORT=/path/to/appearance-report.json
# VOLLEYCUT_SIDE_SWITCH_DECISIONS=/path/to/review-decisions.json
# VOLLEYCUT_SIDE_SWITCH_MARKERS=/path/to/full-video-marker-review.json
# VOLLEYCUT_SIDE_SWITCH_V5_EVALUATION=/path/to/v5-evaluation.json
# VOLLEYCUT_SIDE_SWITCH_V5_FEATURES=/path/to/v5-features.json
# VOLLEYCUT_SIDE_SWITCH_V5_STATE_EVALUATION=/path/to/v5-state-evaluation.json
# VOLLEYCUT_SIDE_SWITCH_V5_STATE_FEATURES=/path/to/v5-state-features.json
# VOLLEYCUT_SIDE_SWITCH_V5_STATE_MODEL=/path/to/v5-state-model.json
# VOLLEYCUT_SIDE_SWITCH_V6_EVALUATION=/path/to/v6-evaluation.json
# VOLLEYCUT_SIDE_SWITCH_V6_FEATURES=/path/to/v6-features.json

# Optional Linux/Intel acceleration. Requires Docker, the pinned Jellyfin image,
# and /dev/dri/renderD128. Omit for the portable FFmpeg/libx264 path.
# VOLLEYCUT_PROXY_BACKEND=jellyfin-vaapi
# VOLLEYCUT_VAAPI_IMAGE=jellyfin/jellyfin@sha256:17285f9cce63b3519ccad82b84497fc22482c20f8b8bbe0580d51fec5deaa6fd

# Optional comma-separated hostnames for LAN development through a custom DNS
# name or reverse proxy. Active non-loopback IPv4 interfaces are allowed
# automatically. Do not include schemes or ports.
# VOLLEYCUT_DEV_ORIGINS=volleycut.local

# Optional public/application URLs used by report generators and local tooling.
# VOLLEYCUT_APP_BASE_URL=http://localhost:3000
# VOLLEYCUT_REPORT_BASE_URL=http://localhost:8080/reports
# VOLLEYCUT_REPORT_OUTPUT_DIR=/path/to/generated-reports

# Optional Codex executable override. When omitted, `codex` is resolved from PATH.
# VOLLEYCUT_CODEX_BIN=/path/to/codex

# Private, untracked source alias ledger used by research jobs that must resolve
# public source aliases to private media paths.
# VOLLEYCUT_PRIVATE_SOURCE_MAP=/path/to/source-id-aliases.json

# Private iOS lab settings. Supply these in an ignored .env.local file or in the
# invoking process environment; never commit real device or account values.
# VOLLEYCUT_IOS_DEVICE_UDID=<ios-device-udid>
# VOLLEYCUT_IOS_DEVELOPMENT_TEAM=<apple-development-team-id>
# VOLLEYCUT_IOS_LAB_ROOT=/path/to/ios-lab
# VOLLEYCUT_IOS_SSH_HOST=<ssh-host-alias>
# VOLLEYCUT_IOS_REMOTE_PROJECT_ROOT=/path/to/remote/volleysplice
# VOLLEYCUT_IOS_REMOTE_DEPENDENCY_ROOT=/path/to/remote/dependencies
# VOLLEYCUT_IOS_OPENCV_FRAMEWORK_ROOT=/path/to/remote/dependencies/opencv-4.12.0
# VOLLEYCUT_IOS_REMOTE_USER=<remote-user>
# VOLLEYCUT_IOS_REMOTE_UID=<remote-console-user-id>
