{
  "name": "volleycut",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "analysis:setup": "python3 -m venv .venv && .venv/bin/python -m pip install -r analysis/requirements.txt",
    "fixture:analysis": "bash scripts/create-analysis-fixture.sh",
    "dataset:status": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; python3 scripts/dataset-status.py",
    "analyze-no-model": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; .venv/bin/python -m analysis.heuristic_cli",
    "analyze-no-model:dataset": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; .venv/bin/python scripts/analyze-no-model-dataset.py",
    "reanalyze-no-model:dataset": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/reanalyze-no-model-dataset.py",
    "infer:model-dataset": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/infer-model-dataset.py",
    "infer:dual-serve-fusion-dataset": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/infer-dual-serve-fusion-dataset.py",
    "infer:specialist-model-dataset": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/infer-specialist-model-dataset.py",
    "evaluate:model-padding": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/evaluate-model-padding.py",
    "evaluate:model-features": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/evaluate-model-features.py",
    "evaluate:transition-features": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/evaluate-transition-features.py",
    "evaluate:court-relative-features": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/evaluate-court-relative-features.py",
    "evaluate:multistate-features": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/evaluate-multistate-features.py",
    "evaluate:multistate-followup": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/evaluate-multistate-followup.py",
    "evaluate:component-selector": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/evaluate-component-selector.py",
    "report:label-readiness": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/report-label-readiness.py",
    "extract:highres-embeddings": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/extract-highres-embeddings.py",
    "evaluate:highres-embeddings": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/evaluate-highres-embeddings.py",
    "prepare:ball-pilot": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/prepare-ball-presence-pilot.py",
    "prepare:ball-sol-review": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/prepare-ball-presence-sol-review.py",
    "detect:ball-pilot": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/run-ball-presence-detector.py",
    "merge:ball-pilot": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/merge-ball-presence-review.py",
    "evaluate:ball-pilot": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/evaluate-ball-presence-detector.py",
    "evaluate:labels": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; PYTHONPATH=. .venv/bin/python scripts/evaluate-labels.py",
    "test:analysis": ".venv/bin/python -m unittest discover -s analysis/tests -v",
    "test:web": "node --experimental-strip-types --test tests/web/*.test.mts",
    "test": "npm run test:web && npm run test:analysis"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.0",
    "typescript": "^5.9.0"
  }
}
