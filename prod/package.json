{
  "name": "volleysplice-prod",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare-assets",
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test:youtube-ui": "node scripts/test-youtube-chapters-ui.mjs",
    "test:inference-ui": "node scripts/test-inference-progress-ui.mjs",
    "test:app-export": "node scripts/test-app-export-ui.mjs",
    "test:score-recovery": "node scripts/test-score-specialists.mjs && node scripts/test-score-specialist-runtime.mjs && node scripts/test-score-recovery-ui.mjs && node scripts/test-score-recovery-cancellation-ui.mjs",
    "test:score-source-integration": "node --test scripts/test-score-source-integration-ui.mjs",
    "test:review-persistence": "node --experimental-strip-types scripts/test-review-persistence.mjs && node scripts/test-review-persistence-ui.mjs && node scripts/test-explicit-split-ui.mjs",
    "test:side-switch-import": "node scripts/test-side-switch-import-ui.mjs",
    "test:project-roundtrip": "node scripts/test-app-project-roundtrip-ui.mjs",
    "test:reconnect-ui": "node scripts/test-app-reconnect-ui.mjs && node scripts/test-app-source-reuse-ui.mjs && node scripts/test-app-source-race-ui.mjs",
    "prebuild": "npm run prepare-assets",
    "build": "npm run check && vite build",
    "postbuild": "node scripts/verify-build.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy:preview": "npm run build && wrangler preview"
  },
  "dependencies": {
    "@techstark/opencv-js": "4.12.0-release.1",
    "fft.js": "4.0.4",
    "mediabunny": "1.53.1",
    "onnxruntime-web": "1.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.5",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.151.3"
  }
}
